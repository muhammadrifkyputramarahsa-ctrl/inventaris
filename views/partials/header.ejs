<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/img/favicon.png">
  <title><%= title %> · StoreSaja</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    // Warna tema StoreSaja (biru tua)
    tailwind.config = { theme: { extend: { colors: { brand: { DEFAULT: '#1e3a8a', dark: '#172554', mid: '#2563eb' } } } } };
  </script>
  <style>
    /* Ikon berwarna mengikuti warna teks (currentColor) lewat mask */
    .ico{display:inline-block;width:1rem;height:1rem;flex-shrink:0;background:currentColor;-webkit-mask:var(--i) center/contain no-repeat;mask:var(--i) center/contain no-repeat}
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen">
<% if (user) { %>
<nav class="bg-brand text-white shadow-md relative">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/dashboard" class="flex items-center gap-2 font-extrabold text-xl tracking-tight"><img src="/img/logo-white.png" alt="" class="h-7 w-7">StoreSaja</a>
    <button class="md:hidden text-2xl" onclick="document.getElementById('menu').classList.toggle('hidden')" aria-label="Menu">☰</button>
    <div id="menu" class="hidden md:flex flex-col md:flex-row md:items-center gap-2 absolute md:static top-full left-0 right-0 bg-brand p-4 md:p-0 z-10 shadow-lg md:shadow-none">
      <a data-nav href="/dashboard" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium text-blue-100 hover:bg-white/10 hover:text-white transition"><span class="ico" style="--i:url(/img/dashboard.svg)"></span>Dashboard</a>
      <a data-nav href="/categories" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium text-blue-100 hover:bg-white/10 hover:text-white transition"><span class="ico" style="--i:url(/img/folder.png)"></span>Kategori</a>
      <a data-nav href="/products" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium text-blue-100 hover:bg-white/10 hover:text-white transition"><span class="ico" style="--i:url(/img/bag.png)"></span>Produk</a>
      <span class="md:ml-3 text-xs bg-white/10 rounded-full px-3 py-1 text-blue-100"><%= user.name %> · <%= user.role %></span>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="bg-red-500 hover:bg-red-600 rounded-lg px-3 py-1.5 text-sm font-medium transition">Logout</button>
      </form>
    </div>
  </div>
</nav>
<% } %>
<main class="max-w-6xl mx-auto px-4 py-6">
<% if (flash) { %>
  <div class="mb-4 rounded-lg px-4 py-3 <%= flash.type === 'error' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800' %>"><%= flash.msg %></div>
<% } %>
