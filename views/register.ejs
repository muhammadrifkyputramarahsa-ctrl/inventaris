<%- include('partials/header') %>
<div class="max-w-sm mx-auto mt-10 bg-white p-6 rounded-lg shadow">
  <div class="text-center mb-5"><img src="/img/bag.png" alt="StoreSaja" class="h-14 w-14 mx-auto mb-1"><div class="text-2xl font-extrabold text-brand">StoreSaja</div><p class="text-sm text-slate-500">Kelola inventori dengan mudah</p></div>
  <form method="post" action="/register" class="space-y-3">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input class="w-full border rounded px-3 py-2" name="name" placeholder="Nama lengkap" required>
    <input class="w-full border rounded px-3 py-2" type="email" name="email" placeholder="Email" required>
    <input class="w-full border rounded px-3 py-2" type="password" name="password" placeholder="Password (min. 8 karakter)" minlength="8" required>
    <button class="w-full bg-brand hover:bg-brand-dark text-white rounded py-2">Daftar</button>
  </form>
  <p class="text-sm mt-4">Sudah punya akun? <a class="text-brand underline" href="/login">Login</a></p>
</div>
<%- include('partials/footer') %>
