<%- include('partials/header') %>
<div class="mb-6">
  <h1 class="text-2xl font-bold text-brand">Halo, <%= user.name %></h1>
  <p class="text-slate-500 text-sm">Ringkasan inventori StoreSaja hari ini.</p>
</div>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <% [['bag','Produk',stats.products,'border-blue-600'],['folder','Kategori',stats.categories,'border-sky-500'],['box','Total Stok',stats.stock,'border-emerald-500'],['money','Nilai Inventori',rupiah(stats.value),'border-amber-500']].forEach(c => { %>
    <div class="bg-white rounded-xl shadow-sm border-l-4 <%= c[3] %> p-4 flex items-center gap-3">
      <div class="h-11 w-11 rounded-lg bg-blue-50 flex items-center justify-center shrink-0"><img src="/img/<%= c[0] %>.png" alt="" class="h-6 w-6"></div>
      <div class="min-w-0">
        <div class="text-xs uppercase tracking-wide text-slate-500"><%= c[1] %></div>
        <div class="text-lg sm:text-xl font-bold break-words"><%= c[2] %></div>
      </div>
    </div>
  <% }) %>
</div>
<div class="grid md:grid-cols-2 gap-4">
  <section class="bg-white rounded-xl shadow-sm p-5">
    <h2 class="flex items-center gap-2 font-semibold text-brand mb-4"><span class="ico" style="--i:url(/img/folder.png)"></span>Produk per Kategori</h2>
    <% const max = Math.max(1, ...perCategory.map(c => c.total)); %>
    <% if (!perCategory.length) { %><p class="text-slate-500 text-sm">Belum ada kategori.</p><% } %>
    <% perCategory.forEach(c => { %>
      <div class="mb-3">
        <div class="flex justify-between text-sm mb-1"><span class="font-medium"><%= c.name %></span><span class="text-slate-500"><%= c.total %> produk</span></div>
        <div class="h-2.5 bg-blue-50 rounded-full"><div class="h-2.5 bg-brand-mid rounded-full" style="width: <%= (c.total / max) * 100 %>%"></div></div>
      </div>
    <% }) %>
  </section>
  <section class="bg-white rounded-xl shadow-sm p-5">
    <h2 class="flex items-center gap-2 font-semibold text-brand mb-4"><span class="ico" style="--i:url(/img/box.png)"></span>Stok Menipis (≤ 5)</h2>
    <% if (!lowStock.length) { %><p class="text-slate-500 text-sm">Semua stok aman</p><% } %>
    <ul class="divide-y">
      <% lowStock.forEach(p => { %>
        <li class="py-2 flex justify-between items-center text-sm">
          <span><%= p.name %> <span class="text-slate-400">· <%= p.category %></span></span>
          <span class="bg-red-100 text-red-700 font-semibold rounded-full px-2.5 py-0.5"><%= p.stock %></span>
        </li>
      <% }) %>
    </ul>
  </section>
</div>
<%- include('partials/footer') %>
